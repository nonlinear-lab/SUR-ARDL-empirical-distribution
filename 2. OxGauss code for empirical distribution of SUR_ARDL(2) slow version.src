@ ==============================================================@
@ OxGauss program for SURARDL		        @ 
@ ============================================================= @
@ Input:      		y: Tx1 vector of time series        	@
@ Output:    		SUR_ARDL distribution	@
@ Subprogram: 		none					@
@ Lag length:		1					@
@ ==============================================================@

closeall;

output file=surardl_distribution_out(a).txt reset;

@ =====data generating process (DGP)===================@
nr=5000;

rhom={0,1};
@ thetam={0,1,0.95,0.90}; @
nnm={50,100,500,1000};
sbm={0.125,0.375,0.625,0.875};

nn1=1;
do while nn1<=rows(nnm);
nn=nnm[nn1]; 

"Number of observation+++" nn;

ns=5;
@ ns is number of countries@
mout1=zeros(ns,7);
ardl1=zeros(nr,1);
ardl2=zeros(nr,1);
ardl3=zeros(nr,1);
ardl4=zeros(nr,1);
ardl5=zeros(nr,1);

i=1;
do while i <=nr;

e=zeros(nn,1);
y=zeros(nn,1);
e1=rndn(nn,1); 
e2=rndn(nn,1); 
e3=rndn(nn,1); 
e4=rndn(nn,1); 

num_obs=nn;
mu=0;
@sigma=0.0000001;@
sigma=1;
/*x=rndLogNorm(num_obs,1,mu,sigma); 
e2=rndn(nn,1)*sigma;*/

y000=zeros(nn,1);
y001=zeros(nn,1);
y002=zeros(nn,1);
trend0=seqa(1,1,nn);
const0=ones(nn,1);

@ =====SUR-ARDL : data preparation for unrestriced model ================================================	@
@ rrr=(rr-2);
lose of two observation@
rrr=(nn-1);

tnc=5;
@ tnc is total number of countries @
tnv=9;
@ tnc is total number of variable in unrestrice model @

yy=zeros(tnc*rrr, 1);
xx=zeros(tnc*rrr,tnc*tnv);

nc=1;
do while nc<=5;
@ nc is number of countries @

j=1;
do while j<=rrr;

rr1=zeros(nn,1);
rr2=zeros(nn,1);
rr3=zeros(nn,1);
rr4=zeros(nn,1);

if nc==1;
rho1=0.92;
endif;
if nc==2;
rho1=0.94;
endif;
if nc==3;
rho1=0.96;
endif;
if nc==4;
rho1=0.98;
endif;
if nc==5;
rho1=1.0;
endif;

mc=1;
do while mc<=nn;
    if mc==1;
    y000[mc,1]=0;
    y001[mc,1]=0;
    y002[mc,1]=0;
    rr1[mc,1]=0;
    rr2[mc,1]=0;
    rr3[mc,1]=0;
    rr4[mc,1]=0;
    else;        
    rr1[mc,1]=rho1*rr1[mc-1]+e1[mc];
    rr2[mc,1]=rho1*rr2[mc-1]+e2[mc];
    rr3[mc,1]=rho1*rr3[mc-1]+e3[mc];
    rr4[mc,1]=rho1*rr4[mc-1]+e4[mc];        
    y000[mc,1]=rr1[mc,1]+const0[mc,1]+trend0[mc,1]+e1[mc,1]; 
    y001[mc,1]=rho1*y001[mc-1,1]+const0[mc,1]+e1[mc,1];
    y002[mc,1]=rho1*y001[mc-1,1]+e1[mc,1];
    endif;
mc=mc+1;
endo;

y0=rr1;
x1=rr2;
x2=rr3;
x3=rr4;

k=1;
n=rows(y0);
dy1=y0[2:n]-y0[1:n-1];
dx1=x1[2:n]-x1[1:n-1];
dx2=x2[2:n]-x2[1:n-1];
dx3=x3[2:n]-x3[1:n-1];
const=ones(n,1);
trend=seqa(1,1,n);
x=dx1[k:n-1]~dx2[k:n-1]~dx3[k:n-1]~const[k+1:n]~trend[k+1:n]~y0[k:n-1]~x1[k:n-1]~x2[k:n-1]~x3[k:n-1];
nc1=cols(x);
y=dy1[k:n-1];
ny1=rows(y);
invx=inv(x'x);
beta=invx*x'y;
e=y-x*beta;

yy[j+rrr*(nc-1)]=y[j];
xx[j+rrr*(nc-1),1+9*(nc-1)]=x[j,1];
xx[j+rrr*(nc-1),2+9*(nc-1)]=x[j,2];
xx[j+rrr*(nc-1),3+9*(nc-1)]=x[j,3];
xx[j+rrr*(nc-1),4+9*(nc-1)]=x[j,4];
xx[j+rrr*(nc-1),5+9*(nc-1)]=x[j,5];
xx[j+rrr*(nc-1),6+9*(nc-1)]=x[j,6];
xx[j+rrr*(nc-1),7+9*(nc-1)]=x[j,7];
xx[j+rrr*(nc-1),8+9*(nc-1)]=x[j,8];
xx[j+rrr*(nc-1),9+9*(nc-1)]=x[j,9];

j=j+1;
endo;

nc=nc+1;
endo;

@ =====SUR_ARDL model (unrestricted model) ==========	@
ncc=tnc;
cc=nc;

eee2=zeros(rrr*ncc,ncc);
eee5=zeros(rrr,ncc);
eee3=zeros(rrr*cc,1);
eee3_1=zeros(rrr,1);
eee3_2=zeros(rrr,1);
eee3_3=zeros(rrr,1);
eee3_4=zeros(rrr,1);
eee3_5=zeros(rrr,1);
beta3_1=zeros(4,1);
beta3_2=zeros(4,1);
beta3_3=zeros(4,1);
beta3_4=zeros(4,1);
beta3_5=zeros(4,1);
sd3_1=zeros(4,1);
sd3_2=zeros(4,1);
sd3_3=zeros(4,1);
sd3_4=zeros(4,1);
sd3_5=zeros(4,1);

invxx=inv(xx'xx);
beta3=invxx*xx'yy;
eee3=yy-xx*beta3;

eee2[1:rrr,1]=eee3[1:rrr];
eee2[1:rrr,2]=eee3[rrr+1:rrr*2];
eee2[1:rrr,3]=eee3[rrr*2+1:rrr*3];
eee2[1:rrr,4]=eee3[rrr*3+1:rrr*4];
eee2[1:rrr,5]=eee3[rrr*4+1:rrr*5];

rss5=eee2'eee2/(rrr);
ccc=rss5.*.eye(rrr);
ccc=inv(ccc);
beta6=inv(xx'ccc*xx)*(xx'ccc*yy);
eee6=yy-xx*beta6;
invxxc=inv(xx'ccc*xx);

beta3_1[1:4]=beta6[1:4];
beta3_2[1:4]=beta6[5:8];
beta3_3[1:4]=beta6[9:12];
beta3_4[1:4]=beta6[13:16];
beta3_5[1:4]=beta6[17:20];

eee3_1[1:rrr]=eee6[1:rrr];
eee3_2[1:rrr]=eee6[rrr+1:rrr*2];
eee3_3[1:rrr]=eee6[rrr*2+1:rrr*3];
eee3_4[1:rrr]=eee6[rrr*3+1:rrr*4];
eee3_5[1:rrr]=eee6[rrr*4+1:rrr*5];

ee1_1=(eee3_1'eee3_1);
ee1_2=(eee3_2'eee3_2);
ee1_3=(eee3_3'eee3_3);
ee1_4=(eee3_4'eee3_4);
ee1_5=(eee3_5'eee3_5);

@ =====SUR-ARDL : data preparation for restriced model ================================================	@
@rrr=(rr-2); @
rrr=(nn-1);

tnc=5;
@ tnc is total number of countries @
tnv=4;
@ tnc is total number of variable in restrice model @

yy=zeros(tnc*rrr, 1);
xx=zeros(tnc*rrr,tnc*tnv);

nc=1;
do while nc<=5;

j=1;
do while j<=rrr;

rr1=zeros(nn,1);
rr2=zeros(nn,1);
rr3=zeros(nn,1);
rr4=zeros(nn,1);

if nc==1;
rho1=0.92;
endif;
if nc==2;
rho1=0.94;
endif;
if nc==3;
rho1=0.96;
endif;
if nc==4;
rho1=0.98;
endif;
if nc==5;
rho1=1.0;
endif;

mc=1;
do while mc<=nn;
    if mc==1;
    y000[mc,1]=0;
    y001[mc,1]=0;
    y002[mc,1]=0;
    rr1[mc,1]=0;
    rr2[mc,1]=0;
    rr3[mc,1]=0;
    rr4[mc,1]=0;
    else;        
    rr1[mc,1]=rho1*rr1[mc-1]+e1[mc];
    rr2[mc,1]=rho1*rr2[mc-1]+e2[mc];
    rr3[mc,1]=rho1*rr3[mc-1]+e3[mc];
    rr4[mc,1]=rho1*rr4[mc-1]+e4[mc];        
    y000[mc,1]=rr1[mc,1]+const0[mc,1]+trend0[mc,1]+e1[mc,1]; 
    y001[mc,1]=rho1*y001[mc-1,1]+const0[mc,1]+e1[mc,1];
    y002[mc,1]=rho1*y001[mc-1,1]+e1[mc,1];
    endif;
mc=mc+1;
endo;

y0=rr1;
x1=rr2;
x2=rr3;
x3=rr4;
k=1;
n=rows(y0);
dy1=y0[2:n]-y0[1:n-1];
dx1=x1[2:n]-x1[1:n-1];
dx2=x2[2:n]-x2[1:n-1];
dx3=x3[2:n]-x3[1:n-1];
const=ones(n,1);
trend=seqa(1,1,n);
x=dx1[k:n-1]~dx2[k:n-1]~dx3[k:n-1]~const[k+1:n];
nc2=cols(x);
y=dy1[k:n-1];
invx=inv(x'x);
beta=invx*x'y;
e=y-x*beta;

yy[j+rrr*(nc-1)]=y[j];
xx[j+rrr*(nc-1),1+4*(nc-1)]=x[j,1];
xx[j+rrr*(nc-1),2+4*(nc-1)]=x[j,2];
xx[j+rrr*(nc-1),3+4*(nc-1)]=x[j,3];
xx[j+rrr*(nc-1),4+4*(nc-1)]=x[j,4];

j=j+1;
endo;

nc=nc+1;
endo;

ncc=tnc;
eee2=zeros(rrr*ncc,ncc);
eee5=zeros(rrr,ncc);
eee3=zeros(rrr*cc,1);
eee3_1=zeros(rrr,1);
eee3_2=zeros(rrr,1);
eee3_3=zeros(rrr,1);
eee3_4=zeros(rrr,1);
eee3_5=zeros(rrr,1);
beta3_1=zeros(4,1);
beta3_2=zeros(4,1);
beta3_3=zeros(4,1);
beta3_4=zeros(4,1);
beta3_5=zeros(4,1);
sd3_1=zeros(4,1);
sd3_2=zeros(4,1);
sd3_3=zeros(4,1);
sd3_4=zeros(4,1);
sd3_5=zeros(4,1);

invxx=inv(xx'xx);
beta3=invxx*xx'yy;
eee3=yy-xx*beta3;

eee2[1:rrr,1]=eee3[1:rrr];
eee2[1:rrr,2]=eee3[rrr+1:rrr*2];
eee2[1:rrr,3]=eee3[rrr*2+1:rrr*3];
eee2[1:rrr,4]=eee3[rrr*3+1:rrr*4];
eee2[1:rrr,5]=eee3[rrr*4+1:rrr*5];

rss5=eee2'eee2/(rrr);
ccc=rss5.*.eye(rrr);
ccc=inv(ccc);
beta6=inv(xx'ccc*xx)*(xx'ccc*yy);
eee6=yy-xx*beta6;
invxxc=inv(xx'ccc*xx);

beta3_1[1:4]=beta6[1:4];
beta3_2[1:4]=beta6[5:8];
beta3_3[1:4]=beta6[9:12];
beta3_4[1:4]=beta6[13:16];
beta3_5[1:4]=beta6[17:20];

eee3_1[1:rrr]=eee6[1:rrr];
eee3_2[1:rrr]=eee6[rrr+1:rrr*2];
eee3_3[1:rrr]=eee6[rrr*2+1:rrr*3];
eee3_4[1:rrr]=eee6[rrr*3+1:rrr*4];
eee3_5[1:rrr]=eee6[rrr*4+1:rrr*5];

ee2_1=(eee3_1'eee3_1);
ee2_2=(eee3_2'eee3_2);
ee2_3=(eee3_3'eee3_3);
ee2_4=(eee3_4'eee3_4);
ee2_5=(eee3_5'eee3_5);

f_num=(ee2_1-ee1_1)/(nc1-nc2);
f_den=ee1_1/(ny1-nc1);
ff1=f_num/f_den;
ardl1[i,1]=ff1;

f_num=(ee2_2-ee1_2)/(nc1-nc2);
f_den=ee1_2/(ny1-nc1);
ff2=f_num/f_den;
ardl2[i,1]=ff2;

f_num=(ee2_3-ee1_3)/(nc1-nc2);
f_den=ee1_3/(ny1-nc1);
ff3=f_num/f_den;
ardl3[i,1]=ff3;

f_num=(ee2_4-ee1_4)/(nc1-nc2);
f_den=ee1_4/(ny1-nc1);
ff4=f_num/f_den;
ardl4[i,1]=ff4;

f_num=(ee2_5-ee1_5)/(nc1-nc2);
f_den=ee1_5/(ny1-nc1);
ff5=f_num/f_den;
ardl5[i,1]=ff5;

i=i+1;
endo;

s_adfm=sortc(ardl1,1);
cv_adfm_1=s_adfm[int(0.01*nr)];
cv_adfm_5=s_adfm[int(0.05*nr)];
cv_adfm_10=s_adfm[int(0.10*nr)];
cv_adfm_50=s_adfm[int(0.50*nr)];
cv_adfm_90=s_adfm[int(0.90*nr)];
cv_adfm_95=s_adfm[int(0.95*nr)];
cv_adfm_99=s_adfm[int(0.99*nr)];

"cv_ardlm_1=" cv_adfm_1;
"cv_ardlm_5=" cv_adfm_5;
"cv_ardlm_10=" cv_adfm_10;
"cv_ardlm_50=" cv_adfm_50;
"cv_ardlm_90=" cv_adfm_90;
"cv_ardlm_95=" cv_adfm_95;
"cv_ardlm_99=" cv_adfm_99;

mout1[1,1]=cv_adfm_1;
mout1[1,2]=cv_adfm_5;
mout1[1,3]=cv_adfm_10;
mout1[1,4]=cv_adfm_50;
mout1[1,5]=cv_adfm_90;
mout1[1,6]=cv_adfm_95;
mout1[1,7]=cv_adfm_99;

s_adfm=sortc(ardl2,1);
cv_adfm_1=s_adfm[int(0.01*nr)];
cv_adfm_5=s_adfm[int(0.05*nr)];
cv_adfm_10=s_adfm[int(0.10*nr)];
cv_adfm_50=s_adfm[int(0.50*nr)];
cv_adfm_90=s_adfm[int(0.90*nr)];
cv_adfm_95=s_adfm[int(0.95*nr)];
cv_adfm_99=s_adfm[int(0.99*nr)];

"cv_ardlm_1=" cv_adfm_1;
"cv_ardlm_5=" cv_adfm_5;
"cv_ardlm_10=" cv_adfm_10;
"cv_ardlm_50=" cv_adfm_50;
"cv_ardlm_90=" cv_adfm_90;
"cv_ardlm_95=" cv_adfm_95;
"cv_ardlm_99=" cv_adfm_99;

mout1[2,1]=cv_adfm_1;
mout1[2,2]=cv_adfm_5;
mout1[2,3]=cv_adfm_10;
mout1[2,4]=cv_adfm_50;
mout1[2,5]=cv_adfm_90;
mout1[2,6]=cv_adfm_95;
mout1[2,7]=cv_adfm_99;

s_adfm=sortc(ardl3,1);
cv_adfm_1=s_adfm[int(0.01*nr)];
cv_adfm_5=s_adfm[int(0.05*nr)];
cv_adfm_10=s_adfm[int(0.10*nr)];
cv_adfm_50=s_adfm[int(0.50*nr)];
cv_adfm_90=s_adfm[int(0.90*nr)];
cv_adfm_95=s_adfm[int(0.95*nr)];
cv_adfm_99=s_adfm[int(0.99*nr)];

"cv_ardlm_1=" cv_adfm_1;
"cv_ardlm_5=" cv_adfm_5;
"cv_ardlm_10=" cv_adfm_10;
"cv_ardlm_50=" cv_adfm_50;
"cv_ardlm_90=" cv_adfm_90;
"cv_ardlm_95=" cv_adfm_95;
"cv_ardlm_99=" cv_adfm_99;

mout1[3,1]=cv_adfm_1;
mout1[3,2]=cv_adfm_5;
mout1[3,3]=cv_adfm_10;
mout1[3,4]=cv_adfm_50;
mout1[3,5]=cv_adfm_90;
mout1[3,6]=cv_adfm_95;
mout1[3,7]=cv_adfm_99;

s_adfm=sortc(ardl4,1);
cv_adfm_1=s_adfm[int(0.01*nr)];
cv_adfm_5=s_adfm[int(0.05*nr)];
cv_adfm_10=s_adfm[int(0.10*nr)];
cv_adfm_50=s_adfm[int(0.50*nr)];
cv_adfm_90=s_adfm[int(0.90*nr)];
cv_adfm_95=s_adfm[int(0.95*nr)];
cv_adfm_99=s_adfm[int(0.99*nr)];

"cv_ardlm_1=" cv_adfm_1;
"cv_ardlm_5=" cv_adfm_5;
"cv_ardlm_10=" cv_adfm_10;
"cv_ardlm_50=" cv_adfm_50;
"cv_ardlm_90=" cv_adfm_90;
"cv_ardlm_95=" cv_adfm_95;
"cv_ardlm_99=" cv_adfm_99;

mout1[4,1]=cv_adfm_1;
mout1[4,2]=cv_adfm_5;
mout1[4,3]=cv_adfm_10;
mout1[4,4]=cv_adfm_50;
mout1[4,5]=cv_adfm_90;
mout1[4,6]=cv_adfm_95;
mout1[4,7]=cv_adfm_99;

s_adfm=sortc(ardl5,1);
cv_adfm_1=s_adfm[int(0.01*nr)];
cv_adfm_5=s_adfm[int(0.05*nr)];
cv_adfm_10=s_adfm[int(0.10*nr)];
cv_adfm_50=s_adfm[int(0.50*nr)];
cv_adfm_90=s_adfm[int(0.90*nr)];
cv_adfm_95=s_adfm[int(0.95*nr)];
cv_adfm_99=s_adfm[int(0.99*nr)];

"cv_ardlm_1=" cv_adfm_1;
"cv_ardlm_5=" cv_adfm_5;
"cv_ardlm_10=" cv_adfm_10;
"cv_ardlm_50=" cv_adfm_50;
"cv_ardlm_90=" cv_adfm_90;
"cv_ardlm_95=" cv_adfm_95;
"cv_ardlm_99=" cv_adfm_99;

mout1[5,1]=cv_adfm_1;
mout1[5,2]=cv_adfm_5;
mout1[5,3]=cv_adfm_10;
mout1[5,4]=cv_adfm_50;
mout1[5,5]=cv_adfm_90;
mout1[5,6]=cv_adfm_95;
mout1[5,7]=cv_adfm_99;

"mout1=" mout1;

nn1=nn1+1;
endo;

@ =====End of calculation================================================	@
